<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reminder_route_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textColor="@color/notification_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reminder_departure_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/notification_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/reminder_freshness"
            android:textColor="@color/notification_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/reminder_borrow_symbol"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:layout_marginEnd="10dp"
            android:background="@drawable/notification_borrow_background"
            android:contentDescription="@string/reminder_borrow_label"
            android:text="@string/reminder_borrow_icon"
            android:includeFontPadding="false"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reminder_borrow_station"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="@color/notification_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reminder_bike_types"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/notification_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/reminder_borrow_forecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="@color/notification_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/reminder_borrow_backup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:visibility="gone"
                android:textColor="@color/notification_borrow_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reminder_borrow_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:textColor="@color/notification_borrow_accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reminder_borrow_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminder_now"
                android:includeFontPadding="false"
                android:textColor="@color/notification_text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/reminder_return_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/reminder_return_symbol"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:layout_marginEnd="10dp"
            android:background="@drawable/notification_return_background"
            android:contentDescription="@string/reminder_return_label"
            android:text="@string/reminder_return_icon"
            android:includeFontPadding="false"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reminder_return_station"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="@color/notification_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reminder_return_forecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="@color/notification_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/reminder_return_backup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:visibility="gone"
                android:textColor="@color/notification_return_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reminder_return_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:textColor="@color/notification_return_accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reminder_return_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminder_now"
                android:includeFontPadding="false"
                android:textColor="@color/notification_text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
