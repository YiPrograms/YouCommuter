# Local development only. Change this password before deployment.
POSTGRES_PASSWORD=youcommuter_dev_only
YOUCOMMUTER_HTTP_PORT=18080

# Official nationwide feed. No account, API key or TDX credentials required.
YOUBIKE_BASE_URL=https://apis.youbike.com.tw/
FEED_POLL_INTERVAL=1m
FEED_STALE_AFTER=5m
# At least 90 days to cover the experimental forecast lookback.
SNAPSHOT_RETENTION_DAYS=90

# Leave empty for an anonymous public prediction service.
PREDICTION_API_KEY=
